<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- 颜色 + 默认值沿用 Spring Boot -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %5p [%t] %clr([req=%X{requestId:-}]){magenta} %-44.44logger{39} : %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 业务包默认 DEBUG，方便观察调用路径 -->
    <logger name="com.chongchao" level="DEBUG"/>

    <!-- Spring / 容器噪音收敛到 INFO -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.boot.autoconfigure" level="INFO"/>
    <logger name="org.springframework.web.servlet" level="INFO"/>

    <!-- DB -->
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <!-- 打开后可看到 JdbcClient / JdbcTemplate 的真实 SQL 和参数 (DEBUG 时) -->
    <logger name="org.springframework.jdbc.core" level="INFO"/>
    <logger name="org.springframework.jdbc.core.StatementCreatorUtils" level="INFO"/>
    <logger name="org.postgresql" level="WARN"/>

</configuration>